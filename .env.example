# Server-side only. No VITE_ prefix, so these never reach the browser bundle.

# Real-time quotes, company news, market news, symbol search.
# Free key: https://finnhub.io/register
FINNHUB_API_KEY=

# AI sentiment analysis. https://platform.deepseek.com
DEEPSEEK_API_KEY=

# Verified available models: deepseek-flash (fast, cheap), deepseek-v4-pro (stronger)
DEEPSEEK_MODEL=deepseek-flash

# PostgreSQL connection string. Required for accounts and per-user watchlists.
DATABASE_URL=postgres://user:password@host:5432/sentiment_desk
# Set explicitly only when the provider's TLS behavior differs from auto-detection.
DATABASE_SSL=true

# QQ Mail sender and SMTP authorization code (not the mailbox password).
QQ_EMAIL=
QQ_EMAIL_AUTH_CODE=
